APP_ENV=development

# Gemini API (free tier: 15 RPM, 1M tokens/day)
GEMINI_API_KEY=

# YouTube OAuth 2.0
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

CHANNEL_ID=

# Publishing
POSTS_PER_DAY=2
AUTO_UPLOAD=false
AUTO_PUBLISH=false
MAX_DAILY_GENERATIONS=2

# Video settings
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
MIN_VIDEO_DURATION=20
MAX_VIDEO_DURATION=60

# Providers
TTS_PROVIDER=local
MEDIA_PROVIDER=free

# Database
DATABASE_URL=sqlite:///data/app.db
