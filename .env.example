APP_ENV=development

# Gemini API (free tier: ~15 RPM, ~1.5M tokens/day; verify current limits)
# Current free-tier model is gemini-2.5-flash. Older models (1.5/2.0-flash) are shut down.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# YouTube OAuth 2.0
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# YouTube Data API v3 (for trending topics fetch - optional, fallback scrapes if missing)
# Enable "YouTube Data API v3" in Google Cloud Console, create API key, restrict to YouTube Data API v3.
YOUTUBE_API_KEY=

CHANNEL_ID=

# Publishing
POSTS_PER_DAY=2
AUTO_UPLOAD=false
AUTO_PUBLISH=false
MAX_DAILY_GENERATIONS=2

# Video settings
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
MIN_VIDEO_DURATION=20
MAX_VIDEO_DURATION=60

# Providers
TTS_PROVIDER=local
MEDIA_PROVIDER=free

# Optional free-tier media API keys (improves asset resilience)
# Pexels: https://www.pexels.com/api/ — free tier 200 req/hr, 20,000/month
# Pixabay: https://pixabay.com/api/docs/ — free tier, requires account
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Database
DATABASE_URL=sqlite:///data/app.db

# ============================================================
# Clipper (automated: turn your long-form videos into Shorts)
# ============================================================
# TWO SOURCE MODES (pick ONE):
#   MODE 1 - S3 BUCKET: drop videos in an S3-compatible bucket
#   MODE 2 - YOUR YOUTUBE CHANNEL: polls your channel for new uploads
#
# COMMON (required for both modes):
YOUTUBE_API_KEY=                # YouTube Data API v3 key (for channel polling)
                                # Enable "YouTube Data API v3" in Google Cloud,
                                # create API key, restrict to YouTube Data API v3.

# MODE 1 - S3 BUCKET (set these if using S3 source):
CLIP_SOURCE_S3_BUCKET=
CLIP_SOURCE_S3_PREFIX=          # optional folder prefix, e.g. "raw/"
CLIP_SOURCE_S3_ENDPOINT=        # REQUIRED for R2/Spaces/MinIO (e.g. https://<acct>.r2.cloudflarestorage.com)
                                # omit for AWS S3
CLIP_SOURCE_S3_ACCESS_KEY=
CLIP_SOURCE_S3_SECRET_KEY=
CLIP_SOURCE_S3_REGION=us-east-1 # "auto" for Cloudflare R2

# MODE 2 - YOUR YOUTUBE CHANNEL (set these if using channel source):
CLIP_SOURCE_YT_CHANNEL_ID=      # your channel ID (UCxxxxxx) or handle (@name)
CLIP_SOURCE_YT_PLAYLIST_ID=     # optional: specific playlist ID (e.g. "UUxxxxx" = uploads)
                                # if omitted, polls the channel's uploads playlist

# Source mode selector (auto-detects from secrets if not set):
# CLIP_SOURCE_MODE=             # "s3" or "youtube" (leave empty to auto-detect)

# Clipper limits (keep within free-tier quotas)
CLIP_MAX_VIDEOS_PER_RUN=2       # max videos processed per scheduled run
CLIP_MAX_CLIPS_PER_VIDEO=1      # max Shorts produced per source video (1-3)
CLIP_UPLOAD=true                # "true" to auto-upload to YouTube

# Whisper transcription (local, zero-cost)
WHISPER_MODEL_SIZE=base.en      # tiny, base.en, small, medium, large

# 9:16 crop mode (currently only "center")
CLIP_CROP_MODE=center
